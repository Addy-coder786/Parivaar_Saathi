# --- Secrets: never commit real environment files (only .env.example is tracked) ---
.env
.env.*
!.env.example
*.env

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- Local database (rebuilt automatically from the demo dataset on start) ---
*.db
*.db-journal
*.sqlite3

# --- Node / frontend build ---
node_modules/
dist/
dist-ssr/
*.local

# --- Logs ---
*.log
logs/

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Local assistant settings ---
.claude/
