# Copy to .env. With no API key the app runs in deterministic Demo Scenario Mode.

# LLM provider: groq (free tier) | anthropic | openai_compatible (e.g. Ollama locally)
LLM_PROVIDER=groq

# --- groq: key from https://console.groq.com/keys ---
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b          (default for groq; alternatives openai/gpt-oss-20b, qwen/qwen3.8-27b — see https://console.groq.com/docs/models)

# --- anthropic: key from https://console.anthropic.com ---
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5              (default for anthropic)

# --- openai_compatible: any OpenAI-style endpoint, e.g. Ollama ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1:8b

# auto = use the LLM if a key is present; demo = always use deterministic Demo Scenario Mode
APP_MODE=auto
# Seconds before a slow LLM call is abandoned and the deterministic reply is used instead
LLM_TIMEOUT=25

DATABASE_PATH=parivaarsaathi.db
CORS_ORIGINS=http://localhost:5173

# --- WhatsApp via Twilio WhatsApp Sandbox (optional; the in-app simulator needs none of this) ---
# Webhook: <PUBLIC_BASE_URL>/channels/whatsapp/twilio  (expose the backend with e.g. `cloudflared tunnel --url http://localhost:8000`)
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=+14155238886
# PUBLIC_BASE_URL=https://<your-tunnel>.trycloudflare.com
# CHANNEL_HASH_SALT=change-me

# --- BHASHINI speech (optional; browser speech is used without it). Keys: https://bhashini.gov.in/ulca ---
# BHASHINI_USER_ID=
# BHASHINI_API_KEY=
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
